# CipherBot environment. Copy to .env (`cp .env.example .env`) and fill in the
# token. Never commit .env — it is git-ignored.

# Required. Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# SQLite database file. Docker images default to /data/cipherbot.db instead.
DATABASE_PATH=cipherbot.db

# Optional: comma-separated category IDs for link curation.
# Empty or unset disables the link pipeline.
MONITORED_CATEGORIES=

# Health + metrics listener. Default 0.0.0.0:8080.
# Set to an empty value to disable the HTTP server.
HEALTH_ADDR=0.0.0.0:8080

# Optional intel API keys (free tiers). Leave empty to disable those lookups.
NVD_API_KEY=
VT_API_KEY=
IPINFO_TOKEN=

# Enables the privileged GUILD_MEMBERS intent (anti-raid join gate).
# Requires "Server Members Intent" in the Discord Developer Portal.
ENABLE_MEMBER_INTENT=false

# Tracing filter. Examples: info, debug, warn, info,cipherbot=debug.
RUST_LOG=info,cipherbot=debug

# YAML config file. Missing file = defaults + environment only.
CONFIG_PATH=config.yaml
